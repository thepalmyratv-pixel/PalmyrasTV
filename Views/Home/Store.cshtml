@{
    ViewData["Title"] = "Store";
}

<div class="store-page">

    <div class="store-header">
        <h1>🛍 PalmyrasTV Store</h1>
        <p>Official Jerseys & Premium Merchandise</p>
    </div>

    <div class="store-grid">

        <div class="product-card">
            <img src="/images/jersey.jpg" alt="Jersey">
            <h3>Barcelona Jersey</h3>
            <p class="price">₹1499</p>

            <button>Buy Now</button>
        </div>

        <div class="product-card">
            <img src="/images/jersey.jpg" alt="Jersey">
            <h3>Real Madrid Jersey</h3>
            <p class="price">₹1599</p>

            <button>Buy Now</button>
        </div>

        <div class="product-card">
            <img src="/images/jersey.jpg" alt="Jersey">
            <h3>Manchester United</h3>
            <p class="price">₹1699</p>

            <button>Buy Now</button>
        </div>

        <div class="product-card">
            <img src="/images/jersey.jpg" alt="Jersey">
            <h3>Argentina Jersey</h3>
            <p class="price">₹1799</p>

            <button>Buy Now</button>
        </div>

    </div>

</div>