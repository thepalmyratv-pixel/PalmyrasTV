@{
    ViewData["PalmyrasTV"] = "Home";
}

<div class="hero-banner">

    <img src="/images/banner.jpg" class="hero-thumb" />

    <div class="hero-overlay">
        <h1>LIVE TV</h1>
        <p>Watch Live Streaming</p>

        <button class="watch-btn" onclick="openLiveTV()">
            ▶ Watch Live
        </button>
    </div>

</div>

<div id="liveTvPlayer" class="live-player">
    <iframe
        src="https://famelack.com/tv/sports/buMnowpZS0vaCS"
        frameborder="0"
        allowfullscreen>
    </iframe>
</div>

<script>
    function openLiveTV() {
        document.getElementById("liveTvPlayer").style.display = "block";
        window.scrollTo({
            top: document.getElementById("liveTvPlayer").offsetTop,
            behavior: "smooth"
        });
    }
</script>

<section class="section">
    <h2>Popular Videos</h2>

    <div class="movie-row">

        <div class="movie-card">
            <video controls poster="/images/video.jpg">
                <source src="/videos/Assist.mp4" type="video/mp4">
            </video>
            <h4>Assist</h4>
        </div>

        <div class="movie-card">
            <video controls poster="/images/video.jpg">
                <source src="/videos/Liverpoolklopp.mp4" type="video/mp4">
            </video>
            <h4>Klopp</h4>
        </div>

        <div class="movie-card">
            <video controls poster="/images/video.jpg">
                <source src="/videos/Redland.mp4" type="video/mp4">
            </video>
            <h4>RedlandFC</h4>
        </div>

    </div>
</section>