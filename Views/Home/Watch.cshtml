@{
    ViewData["Title"] = "Watch";
}

<div class="watch-page">

    <div class="watch-header">

        <h1>Palmyras TV Live</h1>

        <p>Watch live streaming directly inside PalmyrasTV</p>

        <button class="watch-btn" onclick="openPlayer()">
            ▶ Watch Live
        </button>

    </div>

    <div id="livePlayer" class="live-player">

        <iframe
            src="https://famelack.com/"
            frameborder="0"
            allowfullscreen>
        </iframe>

    </div>

</div>

<script>

function openPlayer(){

    document.getElementById("livePlayer").style.display = "block";

    window.scrollTo({
        top: document.getElementById("livePlayer").offsetTop,
        behavior: "smooth"
    });

}

</script>