<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - PalmyrasTV</title>

    <link rel="icon" href="~/favicon.ico" />

    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>

<body style="background-color:#0f0f0f; color:white;">

    <header>
        <nav class="navbar navbar-expand-sm navbar-dark bg-dark border-bottom mb-3">
            <div class="container-fluid">

                <!-- ✅ LOGO (ONLY ONE) -->
                <a class="navbar-brand d-flex align-items-center" asp-controller="Home" asp-action="Index">
                    <img src="~/images/logo.png" alt="logo" style="height:40px; margin-right:10px;" />
                    PalmyraTV
                </a>

                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav">
                    <span class="navbar-toggler-icon"></span>
                </button>

                <div class="collapse navbar-collapse" id="navbarNav">
                    <ul class="navbar-nav ms-auto">

                        <li class="nav-item">
                            <a class="nav-link text-white" asp-controller="Home" asp-action="Index">Home</a>
                        </li>

                        <li class="nav-item">
                            <a class="nav-link text-white" asp-controller="Home" asp-action="Privacy">Privacy</a>
                        </li>

                        <li class="nav-item">
                            <a class="nav-link text-white" asp-controller="Home" asp-action="Watch">Watch</a>
                        </li>

                    </ul>
                </div>

            </div>
        </nav>
    </header>

    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <footer class="footer-section">
    <div class="footer-container">

        <div class="footer-about">
            <h3>PalmyrasTV</h3>
            <p>
                PalmyrasTV is a modern OTT streaming platform for
                entertainment, sports, movies
                and digital learnings.
            </p>
        </div>

        <div class="footer-links">
            <h4>Quick Links</h4>
            <a href="#">Home</a>
            <a href="#">About</a>
            <a href="#">Privacy Policy</a>
            <a href="#">Terms & Conditions</a>
        </div>

        <div class="footer-social">
            <h4>Follow Us</h4>
            <a href="https://www.youtube.com/channel/UCEDNVttVjkPpjvU61GgU0Fg" target="_blank">YouTube</a>
            <a href="https://instagram.com/palmyrastv" target="_blank">Instagram</a>
            <a href="https://facebook.com/palmyrastv" target="_blank">Facebook</a>
            <a href="https://x.com/palmyrastv" target="_blank">X / Twitter</a>
        </div>

    </div>

    <div class="footer-bottom">
        <p>
            © 2026 - PalmyrasTV by Assist • All Rights Reserved
        </p>
    </div>
</footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>